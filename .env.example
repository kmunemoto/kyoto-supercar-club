# Public site URL used for canonical, OGP, JSON-LD, sitemap, robots.
# Change this once when connecting a custom domain.
VITE_PUBLIC_SITE_URL=https://start-your-spark-56.lovable.app

# Lovable Cloud injects these when Cloud is connected. Do not put service role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Newer Lovable projects may use this name instead of ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional override for the official LINE URL.
# Default is set in src/lib/site.ts (OFFICIAL_LINE_URL).
# Set to "off" to remove every LINE call to action from the site.
# VITE_KSC_LINE_URL=https://line.me/ti/p/eMWqcmXxia

# Optional analytics. Leave empty to disable. Scripts load only after consent.
# VITE_GA_MEASUREMENT_ID=
# VITE_META_PIXEL_ID=

# Server-only secrets: set these in Lovable Cloud Secrets, not here.
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# NOTIFY_EMAIL=
# NOTIFY_FROM=   # must be on a domain verified in Resend, or nothing is delivered
